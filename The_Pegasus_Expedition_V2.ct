<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="45"><CheatEntries><CheatEntry><ID>0</ID><Description>"THE PEGASUS EXPEDITION | V2 | mono based | NO GAME TEST"</Description><GroupHeader>1</GroupHeader><CheatEntries><CheatEntry><ID>1</ID><Description>"01 - MASTER: dynamic human-player &amp; resource pointers (enable first)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
if PegasusV2 and PegasusV2.timer then
  showMessage('Pegasus V2 is already active. Disable the master entry before reloading.')
  return
end
local ok,err=pcall(function()
  if getOpenedProcessID()==0 then error('Attach Cheat Engine to the game process first.') end
  if not monopipe then LaunchMonoDataCollector() end
  if not monopipe then error('Mono collector is unavailable.') end
  local P={flags={fleet=false,operative=false,combat=false}, records={}, tickCount=0}
  PegasusV2=P
  local function chk(p) return type(p)=='number' and p&gt;0x10000 and p&lt;0x7FFFFFFFFFFF end
  P.chk=chk
  function P.ptr(a) if not chk(a) then return nil end local v=readPointer(a); if chk(v) then return v end end
  function P.off(cl, name)
    if not cl or cl==0 then error('Missing Mono class: '..tostring(name)) end
    for _, f in ipairs(mono_class_enumFields(cl,true) or {}) do
      if f.name==name then return f.offset, f end
    end
    error('Missing Mono field: '..name)
  end
  local ids={}
  for _,name in ipairs({'Main','Grand','GrandPlayer','PlayerResources','ResourceArray','ResourceAmounts','ResourceAmount',
    'PlayerMovablePool','StarFleet','StarOperative','Star','UnitConstruction','StarUnit','Unit','ShipC','Player'}) do
    local id=mono_findClass('',name)
    if not id or id==0 then error('Cannot find class: '..name) end
    ids[name]=id
  end
  P.ids=ids
  local a={}
  local function F(klass,name) a[klass..'.'..name]=P.off(ids[klass],name) end
  for _,pair in ipairs({
    {'Main','Grand'},{'Main','HumanPlayer'},
    {'Grand','&lt;HumanPlayer&gt;k__BackingField'},
    {'GrandPlayer','&lt;Resources&gt;k__BackingField'},{'GrandPlayer','&lt;MovablePool&gt;k__BackingField'},
    {'GrandPlayer','&lt;Stars&gt;k__BackingField'},
    {'PlayerResources','&lt;Resources&gt;k__BackingField'},{'PlayerResources','ResourceNameIndex'},
    {'ResourceArray','values'},{'ResourceAmounts','Data'}, {'ResourceAmount','Type'}, {'ResourceAmount','Amount'},
    {'PlayerMovablePool','fleets'},{'PlayerMovablePool','operatives'},
    {'StarFleet','&lt;Owner&gt;k__BackingField'},{'StarFleet','&lt;MovementPoints&gt;k__BackingField'},
    {'StarFleet','&lt;RepairTurnsLeft&gt;k__BackingField'}, {'StarFleet','&lt;IsRepairing&gt;k__BackingField'},
    {'StarFleet','&lt;Units&gt;k__BackingField'}, {'StarFleet','&lt;Flagship&gt;k__BackingField'},
    {'StarOperative','&lt;Owner&gt;k__BackingField'},{'StarOperative','&lt;MovementPoints&gt;k__BackingField'},
    {'StarOperative','&lt;ActionPoints&gt;k__BackingField'},
    {'Star','&lt;Owner&gt;k__BackingField'}, {'Star','&lt;UnitConstruction&gt;k__BackingField'},
    {'UnitConstruction','queue'},
    {'StarUnit','&lt;RemainingConstruction&gt;k__BackingField'}, {'StarUnit','&lt;CumulativeRemainingConstruction&gt;k__BackingField'},
    {'Player','&lt;Units&gt;k__BackingField'}, {'Unit','Owner'}, {'Unit','&lt;Ships&gt;k__BackingField'},
    {'ShipC','health'}, {'ShipC','maximumHealth'},
  }) do F(pair[1],pair[2]) end
  P.a=a
  -- This main static field is a reliable *runtime root*, not an address saved from a previous process.
  P.domain=nil; P.static=nil
  for _,domain in ipairs(mono_enumDomains() or {}) do
    local success,base=pcall(mono_class_getStaticFieldAddress,domain,ids.Main)
    if success and chk(base) then
      local g=P.ptr(base+a['Main.Grand'])
      if g then P.domain=domain; P.static=base; break end
    end
  end
  if not P.static then error('Main.Grand is null. Load a saved campaign and retry.') end
  P.globalGroupDescription='Pegasus V2 | LIVE resolved resources (edit values carefully)'
  local al=getAddressList()
  local previous=al.getMemoryRecordByDescription(P.globalGroupDescription)
  if previous then previous.destroy() end
  local root=al.createMemoryRecord()
  root.Description=P.globalGroupDescription; root.IsGroupHeader=true
  P.group=root
  function P.player()
    local grand=P.ptr(P.static+a['Main.Grand'])
    if not grand then return end
    return P.ptr(grand+a['Grand.&lt;HumanPlayer&gt;k__BackingField'])
  end
  function P.combatPlayer()
    return P.ptr(P.static+a['Main.HumanPlayer'])
  end
  function P.list(ls,maxnum)
    local found={}
    if not ls then return found end
    local arr=P.ptr(ls+0x10)
    local n=readInteger(ls+0x18)
    if not arr or not n or n&lt;0 or n&gt;(maxnum or 4096) then return found end
    for i=0,n-1 do
      local v=P.ptr(arr+0x20+i*8)
      if v then found[#found+1]=v end
    end
    return found
  end
  function P.fleets()
    local h=P.player(); if not h then return {} end
    local pool=P.ptr(h+a['GrandPlayer.&lt;MovablePool&gt;k__BackingField'])
    if not pool then return {} end
    local l=P.ptr(pool+a['PlayerMovablePool.fleets']); local r={}
    for _,f in ipairs(P.list(l,2048)) do
      if P.ptr(f+a['StarFleet.&lt;Owner&gt;k__BackingField'])==h then r[#r+1]=f end
    end
    return r
  end
  function P.operatives()
    local h=P.player(); if not h then return {} end
    local pool=P.ptr(h+a['GrandPlayer.&lt;MovablePool&gt;k__BackingField'])
    if not pool then return {} end
    local l=P.ptr(pool+a['PlayerMovablePool.operatives']); local r={}
    for _,op in ipairs(P.list(l,2048)) do
      if P.ptr(op+a['StarOperative.&lt;Owner&gt;k__BackingField'])==h then r[#r+1]=op end
    end
    return r
  end
  function P.resourceNames()
    local result={}
    local sb
    local success,base=pcall(mono_class_getStaticFieldAddress,P.domain,ids.PlayerResources)
    if success and chk(base) then sb=base end
    local arr=sb and P.ptr(sb+a['PlayerResources.ResourceNameIndex'])
    local n=arr and readQword(arr+0x18)
    if n and n&gt;=1 and n&lt;80 then
      for i=0,n-1 do
        local st=P.ptr(arr+0x20+i*8)
        if st then
          local chars=readInteger(st+0x10)
          if chars and chars&gt;0 and chars&lt;100 then result[i]=readString(st+0x14,chars,true) end
        end
      end
    end
    return result
  end
  function P.resourceAddresses()
    local h=P.player(); if not h then return {},'human player not loaded' end
    local pRes=P.ptr(h+a['GrandPlayer.&lt;Resources&gt;k__BackingField'])
    local raw=pRes and P.ptr(pRes+a['PlayerResources.&lt;Resources&gt;k__BackingField'])
    if not raw then return {},'resources object not loaded' end
    local okClass,clId=pcall(mono_object_getClass,raw)
    if not okClass or not clId or clId==0 then return {},'could not identify resources class' end
    local name=mono_class_getName(clId)
    local vals={}
    if name=='ResourceArray' then
      local arr=P.ptr(raw+a['ResourceArray.values'])
      local size=arr and readQword(arr+0x18)
      if not size or size&lt;1 or size&gt;64 then return {},'float array length invalid' end
      for i=0,size-1 do vals[i]=arr+0x20+i*4 end
    elseif name=='ResourceAmounts' then
      local ls=P.ptr(raw+a['ResourceAmounts.Data'])
      for _,item in ipairs(P.list(ls,128)) do
        local t=readInteger(item+a['ResourceAmount.Type'])
        if t and t&gt;=0 and t&lt;64 then vals[t]=item+a['ResourceAmount.Amount'] end
      end
    else return {},'unrecognized runtime class '..tostring(name) end
    return vals,name
  end
  local function norm(s) return tostring(s or ''):lower():gsub('[^a-z0-9]','') end
  function P.refreshResources()
    local addresses,ctype=P.resourceAddresses()
    if not next(addresses) then P.lastResourceError=ctype;return end
    local names=P.resourceNames()
    for i=0,63 do
      local addr=addresses[i]
      if addr then
        local label=names[i] or ('enum # '..i..' (compare with game UI)')
        local n=norm(label)
        local category='Resource'
        if n:find('mineral') then category='Minerals / 矿物'
        elseif n:find('rareearth') or n:find('rareore') then category='Rare Earth / 稀土'
        elseif n:find('population') then category='Population / 人口' end
        local mr=P.records[i]
        if not mr then
          mr=al.createMemoryRecord(); mr.appendToEntry(P.group)
          mr.Type=vtSingle; P.records[i]=mr
        end
        mr.Description=string.format('%s | %s [enum %d] | %s',category,label,i,ctype)
        mr.Address=string.format('%X',addr)
      end
    end
    P.lastResourceError=nil
  end
  function P.applyMovement()
    if P.flags.fleet then
      for _,f in ipairs(P.fleets()) do
        local addr=f+a['StarFleet.&lt;MovementPoints&gt;k__BackingField']
        local n=readInteger(addr)
        if n and n&gt;=0 and n&lt;999 then writeInteger(addr,999) end
      end
    end
    if P.flags.operative then
      for _,o in ipairs(P.operatives()) do
        local mp=o+a['StarOperative.&lt;MovementPoints&gt;k__BackingField']
        local ap=o+a['StarOperative.&lt;ActionPoints&gt;k__BackingField']
        local m=readInteger(mp); local n=readInteger(ap)
        if m and m&gt;=0 and m&lt;99 then writeInteger(mp,99) end
        if n and n&gt;=0 and n&lt;99 then writeInteger(ap,99) end
      end
    end
  end
  function P.regenerateCombatShips()
    local hum=P.combatPlayer(); if not hum then return 0 end
    local units=P.ptr(hum+a['Player.&lt;Units&gt;k__BackingField']); local count=0
    local health=a['ShipC.health'];local maximum=a['ShipC.maximumHealth']
    if maximum-health~=4 then return 0 end
    for _,unit in ipairs(P.list(units,2048)) do
      if P.ptr(unit+a['Unit.Owner'])==hum then
        local ships=P.ptr(unit+a['Unit.&lt;Ships&gt;k__BackingField'])
        for _,ship in ipairs(P.list(ships,4096)) do
          local max=readInteger(ship+maximum)
          local hp=readInteger(ship+health)
          if hp and max and hp&gt;0 and hp&lt;max and max&lt;2000000000 then
            if writeInteger(ship+health,max) then count=count+1 end
          end
        end
      end
    end
    return count
  end
  function P.instantBuildOnce()
    local hum=P.player(); if not hum then error('No human player loaded') end
    local cnt,unique=0,{}
    local function complete(unit)
      if not unit or unique[unit] then return end
      unique[unit]=true
      local r=unit+a['StarUnit.&lt;RemainingConstruction&gt;k__BackingField']
      local c=unit+a['StarUnit.&lt;CumulativeRemainingConstruction&gt;k__BackingField']
      local remaining=readInteger(r)
      if remaining and remaining&gt;0 and remaining&lt;100000000 then
        writeInteger(r,0);writeInteger(c,0);cnt=cnt+1
      end
    end
    for _,star in ipairs(P.list(P.ptr(hum+a['GrandPlayer.&lt;Stars&gt;k__BackingField']),4096)) do
      if P.ptr(star+a['Star.&lt;Owner&gt;k__BackingField'])==hum then
        local cons=P.ptr(star+a['Star.&lt;UnitConstruction&gt;k__BackingField'])
        local queue=cons and P.ptr(cons+a['UnitConstruction.queue'])
        for _,unit in ipairs(P.list(queue,2048)) do complete(unit) end
      end
    end
    for _,f in ipairs(P.fleets()) do
      local flist=P.ptr(f+a['StarFleet.&lt;Units&gt;k__BackingField'])
      for _,unit in ipairs(P.list(flist,2048)) do complete(unit) end
      complete(P.ptr(f+a['StarFleet.&lt;Flagship&gt;k__BackingField']))
    end
    return cnt
  end
  function P.repairOnce()
    local mid=mono_findMethod('','StarFleet','RepairByAmount')
    if not mid or mid==0 then error('StarFleet.RepairByAmount not found') end
    local fleets=P.fleets()
    if #fleets==0 then error('No player fleets found') end
    local failures=0; local successes=0
    for _,fleet in ipairs(fleets) do
      -- Explicit experimental managed call; never touch enemy fleets.
      local okCall=pcall(mono_invoke_method,P.domain,mid,fleet,{{type=12,value=9999.0}})
      if okCall then
        successes=successes+1
        local r=fleet+a['StarFleet.&lt;RepairTurnsLeft&gt;k__BackingField']
        local n=readInteger(r)
        if n and n&gt;0 and n&lt;2000 then writeInteger(r,0) end
      else failures=failures+1 end
    end
    return successes,failures
  end
  function P.diag()
    local path=(os.getenv('TEMP') or '.')..'\\Pegasus_V2_Diagnostics.txt'
    local f=assert(io.open(path,'w'))
    local function line(s) f:write(s,'\n') end
    line('Pegasus V2 diagnostic (runtime only)')
    line('Main static = '..string.format('%X',P.static))
    local hum=P.player();line('Grand.HumanPlayer = '..(hum and string.format('%X',hum) or 'nil'))
    local cr=P.combatPlayer();line('Main.HumanPlayer combat = '..(cr and string.format('%X',cr) or 'nil'))
    local addresses,typeName=P.resourceAddresses();line('Container type = '..tostring(typeName))
    local names=P.resourceNames()
    for i=0,63 do
      local addr=addresses[i]
      if addr then line(string.format('RESOURCE enum=%d key=%s address=%X value=%s',i,tostring(names[i]),addr,tostring(readFloat(addr)))) end
    end
    local fleets=P.fleets();local operatives=P.operatives()
    line('Player fleet count = '..#fleets..' | operative count = '..#operatives)
    for i,fl in ipairs(fleets) do
      line(string.format('FLEET %d ptr=%X movement=%s repairTurns=%s',i,fl,tostring(readInteger(fl+a['StarFleet.&lt;MovementPoints&gt;k__BackingField'])),tostring(readInteger(fl+a['StarFleet.&lt;RepairTurnsLeft&gt;k__BackingField']))))
    end
    for i,o in ipairs(operatives) do
      line(string.format('OPERATIVE %d ptr=%X move=%s action=%s',i,o,tostring(readInteger(o+a['StarOperative.&lt;MovementPoints&gt;k__BackingField'])),tostring(readInteger(o+a['StarOperative.&lt;ActionPoints&gt;k__BackingField']))))
    end
    for _,clName in ipairs({'FixedPoint','ShipC','ResourceArray','ResourceAmounts'}) do
      local id=mono_findClass('',clName)
      line('CLASS '..clName..'='..tostring(id))
      if id and id~=0 then
        for _,field in ipairs(mono_class_enumFields(id,true) or {}) do
          line(string.format('  %s type=%s offset=%X static=%s',tostring(field.name),tostring(field.typename),tonumber(field.offset) or 0,tostring(field.isStatic)))
        end
      end
    end
    f:close();return path
  end
  P.refreshResources()
  local t=createTimer(nil,false)
  P.timer=t
  t.Interval=400
  t.OnTimer=function()
    if not PegasusV2 or PegasusV2~=P or getOpenedProcessID()==0 then t.Enabled=false;return end
    local success,msg=pcall(function()
      P.tickCount=P.tickCount+1
      if P.tickCount%5==0 then P.refreshResources() end
      P.applyMovement()
      if P.flags.combat then P.regenerateCombatShips() end
    end)
    if not success then
      t.Enabled=false
      showMessage('Pegasus V2 timer stopped safely due to error:\n'..tostring(msg))
    end
  end
  t.Enabled=true
  showMessage('Pegasus V2 master enabled. Resources resolved: '..tostring((function() local n=0;for _ in pairs(P.records) do n=n+1 end;return n end)())..'\nResource status: '..tostring(P.lastResourceError or 'found')..'\nActivate optional cheat entries separately.\nUse diagnostic export if resource labels are not verified.')
end)
if not ok then PegasusV2=nil;showMessage('Pegasus V2 activation failed:\n'..tostring(err)) end
[DISABLE]
if PegasusV2 then
  local P=PegasusV2
  if P.timer then P.timer.destroy() end
  if P.group then P.group.destroy() end
  PegasusV2=nil
end
</AssemblerScript></CheatEntry><CheatEntry><ID>2</ID><Description>"02 - PLAYER fleet unlimited movement (continuous)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
if PegasusV2 then PegasusV2.flags.fleet=true else showMessage('First activate 01 - Master Mono player resolver.') end
[DISABLE]
if PegasusV2 then PegasusV2.flags.fleet=false end
</AssemblerScript></CheatEntry><CheatEntry><ID>3</ID><Description>"03 - PLAYER operative unlimited movement + action points (continuous)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
if PegasusV2 then PegasusV2.flags.operative=true else showMessage('First activate 01 - Master Mono player resolver.') end
[DISABLE]
if PegasusV2 then PegasusV2.flags.operative=false end
</AssemblerScript></CheatEntry><CheatEntry><ID>4</ID><Description>"04 - PLAYER combat ship health regeneration (experimental continuous)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
if PegasusV2 then PegasusV2.flags.combat=true else showMessage('First activate 01 - Master Mono player resolver.') end
[DISABLE]
if PegasusV2 then PegasusV2.flags.combat=false end
</AssemblerScript></CheatEntry><CheatEntry><ID>5</ID><Description>"05 - COMPLETE owned-star ship queues NOW (once; finish may need game tick)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
local P=PegasusV2
if not P then showMessage('First enable 01 - Master Mono player resolver.');return end
local ok,val1,val2=pcall(function() return P.instantBuildOnce() end)
if ok then showMessage('Set remaining construction to zero for '..tostring(val1)..' owned StarUnits. Completion may occur on a subsequent game construction tick.') else showMessage('Pegasus V2 error:\n'..tostring(val1)) end
[DISABLE]
</AssemblerScript></CheatEntry><CheatEntry><ID>6</ID><Description>"06 - REPAIR own fleets NOW via Mono RepairByAmount (EXPERIMENTAL once)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
local P=PegasusV2
if not P then showMessage('First enable 01 - Master Mono player resolver.');return end
local ok,val1,val2=pcall(function() return P.repairOnce() end)
if ok then showMessage('Invoked StarFleet.RepairByAmount on '..tostring(val1)..' own fleets. Errors: '..tostring(val2)..'. Verify health and costs in game.') else showMessage('Pegasus V2 error:\n'..tostring(val1)) end
[DISABLE]
</AssemblerScript></CheatEntry><CheatEntry><ID>7</ID><Description>"07 - Export focused runtime diagnostics to TEMP (read-only)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
local P=PegasusV2
if not P then showMessage('First enable 01 - Master Mono player resolver.');return end
local ok,val1,val2=pcall(function() return P.diag() end)
if ok then showMessage('Diagnostic file created: '..tostring(val1)) else showMessage('Pegasus V2 error:\n'..tostring(val1)) end
[DISABLE]
</AssemblerScript></CheatEntry><CheatEntry><ID>8</ID><Description>"IMPORTANT | reset once-only entries to run again (uncheck then check)"</Description><GroupHeader>1</GroupHeader><CheatEntries /></CheatEntry><CheatEntry><ID>9</ID><Description>"IMPORTANT | save backup, single-player only, never enable on title screen"</Description><GroupHeader>1</GroupHeader><CheatEntries /></CheatEntry></CheatEntries></CheatEntry></CheatEntries></CheatTable>