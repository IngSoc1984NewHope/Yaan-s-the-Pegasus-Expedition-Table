<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="45"><CheatEntries><CheatEntry><ID>3000</ID><Description>"THE PEGASUS EXPEDITION | V4 | validated resources &amp; action; safe field-only changes"</Description><GroupHeader>1</GroupHeader><CheatEntries><CheatEntry><ID>3001</ID><Description>"01 - MASTER: 6 named float resource pointers + player pointers"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
if PegasusV3 and PegasusV3.timer then
  showMessage('Pegasus V3 is already active. Disable the master entry before reloading.')
  return
end
local ok,err=pcall(function()
  if getOpenedProcessID()==0 then error('Attach Cheat Engine to the game process first.') end
  if not monopipe then LaunchMonoDataCollector() end
  if not monopipe then error('Mono collector is unavailable.') end
  -- Disable all V2 scripts and timers before a single V3 write. V2 forced 999/99.
  if PegasusV2 then
    local old=PegasusV2
    if old.flags then old.flags.fleet=false;old.flags.operative=false;old.flags.combat=false end
    if old.timer then old.timer.Enabled=false; pcall(function()old.timer.destroy()end);old.timer=nil end
    if old.group then pcall(function()old.group.destroy()end);old.group=nil end
    PegasusV2=nil
  end
  local P={flags={fleet=false,operative=false,combat=false}, symbols={}, tickCount=0}
  PegasusV3=P
  local function chk(p) return type(p)=='number' and p&gt;0x10000 and p&lt;0x7FFFFFFFFFFF end
  P.chk=chk
  function P.ptr(a) if not chk(a) then return nil end local v=readPointer(a); if chk(v) then return v end end
  function P.off(cl, name)
    if not cl or cl==0 then error('Missing Mono class: '..tostring(name)) end
    for _, f in ipairs(mono_class_enumFields(cl,true) or {}) do
      if f.name==name then return f.offset, f end
    end
    error('Missing Mono field: '..name)
  end
  local ids={}
  for _,name in ipairs({'Main','Grand','GrandPlayer','PlayerResources','ResourceArray','ResourceAmounts','ResourceAmount',
    'PlayerMovablePool','StarFleet','StarOperative','Star','UnitConstruction','StarUnit','Unit','ShipC','Player'}) do
    local id=mono_findClass('',name)
    if not id or id==0 then error('Cannot find class: '..name) end
    ids[name]=id
  end
  P.ids=ids
  local a={}
  local function F(klass,name) a[klass..'.'..name]=P.off(ids[klass],name) end
  for _,pair in ipairs({
    {'Main','Grand'},{'Main','HumanPlayer'},
    {'Grand','&lt;HumanPlayer&gt;k__BackingField'},
    {'GrandPlayer','&lt;Resources&gt;k__BackingField'},{'GrandPlayer','&lt;MovablePool&gt;k__BackingField'},
    {'GrandPlayer','&lt;Stars&gt;k__BackingField'},
    {'PlayerResources','&lt;Resources&gt;k__BackingField'},{'PlayerResources','ResourceNameIndex'},
    {'ResourceArray','values'},{'ResourceAmounts','Data'}, {'ResourceAmount','Type'}, {'ResourceAmount','Amount'},
    {'PlayerMovablePool','fleets'},{'PlayerMovablePool','operatives'},
    {'StarFleet','&lt;Owner&gt;k__BackingField'},{'StarFleet','&lt;MovementPoints&gt;k__BackingField'},
    {'StarFleet','&lt;RepairTurnsLeft&gt;k__BackingField'}, {'StarFleet','&lt;IsRepairing&gt;k__BackingField'},
    {'StarFleet','&lt;Units&gt;k__BackingField'}, {'StarFleet','&lt;Flagship&gt;k__BackingField'},
    {'StarOperative','&lt;Owner&gt;k__BackingField'},{'StarOperative','&lt;MovementPoints&gt;k__BackingField'},
    {'StarOperative','&lt;ActionPoints&gt;k__BackingField'},
    {'Star','&lt;Owner&gt;k__BackingField'}, {'Star','&lt;UnitConstruction&gt;k__BackingField'},
    {'UnitConstruction','queue'},
    {'StarUnit','&lt;RemainingConstruction&gt;k__BackingField'}, {'StarUnit','&lt;CumulativeRemainingConstruction&gt;k__BackingField'},
    {'Player','&lt;Units&gt;k__BackingField'}, {'Unit','Owner'}, {'Unit','isImmortal'}, {'Unit','&lt;Ships&gt;k__BackingField'},
    {'ShipC','health'}, {'ShipC','maximumHealth'},
  }) do F(pair[1],pair[2]) end
  P.a=a
  -- This main static field is a reliable *runtime root*, not an address saved from a previous process.
  P.domain=nil; P.static=nil
  for _,domain in ipairs(mono_enumDomains() or {}) do
    local success,base=pcall(mono_class_getStaticFieldAddress,domain,ids.Main)
    if success and chk(base) then
      local g=P.ptr(base+a['Main.Grand'])
      if g then P.domain=domain; P.static=base; break end
    end
  end
  if not P.static then error('Main.Grand is null. Load a saved campaign and retry.') end
  local al=getAddressList()
  function P.player()
    local grand=P.ptr(P.static+a['Main.Grand'])
    if not grand then return end
    return P.ptr(grand+a['Grand.&lt;HumanPlayer&gt;k__BackingField'])
  end
  function P.combatPlayer()
    return P.ptr(P.static+a['Main.HumanPlayer'])
  end
  function P.list(ls,maxnum)
    local found={}
    if not ls then return found end
    local arr=P.ptr(ls+0x10)
    local n=readInteger(ls+0x18)
    if not arr or not n or n&lt;0 or n&gt;(maxnum or 4096) then return found end
    for i=0,n-1 do
      local v=P.ptr(arr+0x20+i*8)
      if v then found[#found+1]=v end
    end
    return found
  end
  function P.fleets()
    local h=P.player(); if not h then return {} end
    local pool=P.ptr(h+a['GrandPlayer.&lt;MovablePool&gt;k__BackingField'])
    if not pool then return {} end
    local l=P.ptr(pool+a['PlayerMovablePool.fleets']); local r={}
    for _,f in ipairs(P.list(l,2048)) do
      if P.ptr(f+a['StarFleet.&lt;Owner&gt;k__BackingField'])==h then r[#r+1]=f end
    end
    return r
  end
  function P.operatives()
    local h=P.player(); if not h then return {} end
    local pool=P.ptr(h+a['GrandPlayer.&lt;MovablePool&gt;k__BackingField'])
    if not pool then return {} end
    local l=P.ptr(pool+a['PlayerMovablePool.operatives']); local r={}
    for _,op in ipairs(P.list(l,2048)) do
      if P.ptr(op+a['StarOperative.&lt;Owner&gt;k__BackingField'])==h then r[#r+1]=op end
    end
    return r
  end
  function P.resourceNames()
    local result={}
    local sb
    local success,base=pcall(mono_class_getStaticFieldAddress,P.domain,ids.PlayerResources)
    if success and chk(base) then sb=base end
    local arr=sb and P.ptr(sb+a['PlayerResources.ResourceNameIndex'])
    local n=arr and readQword(arr+0x18)
    if n and n&gt;=1 and n&lt;80 then
      for i=0,n-1 do
        local st=P.ptr(arr+0x20+i*8)
        if st then
          local chars=readInteger(st+0x10)
          if chars and chars&gt;0 and chars&lt;100 then result[i]=readString(st+0x14,chars,true) end
        end
      end
    end
    return result
  end
  function P.resourceAddresses()
    local h=P.player(); if not h then return {},'human player not loaded' end
    local pRes=P.ptr(h+a['GrandPlayer.&lt;Resources&gt;k__BackingField'])
    local raw=pRes and P.ptr(pRes+a['PlayerResources.&lt;Resources&gt;k__BackingField'])
    if not raw then return {},'resources object not loaded' end
    local okClass,clId=pcall(mono_object_getClass,raw)
    if not okClass or not clId or clId==0 then return {},'could not identify resources class' end
    local name=mono_class_getName(clId)
    local vals={}
    if name=='ResourceArray' then
      local arr=P.ptr(raw+a['ResourceArray.values'])
      local size=arr and readQword(arr+0x18)
      if not size or size&lt;1 or size&gt;64 then return {},'float array length invalid' end
      for i=0,size-1 do vals[i]=arr+0x20+i*4 end
    elseif name=='ResourceAmounts' then
      local ls=P.ptr(raw+a['ResourceAmounts.Data'])
      for _,item in ipairs(P.list(ls,128)) do
        local t=readInteger(item+a['ResourceAmount.Type'])
        if t and t&gt;=0 and t&lt;64 then vals[t]=item+a['ResourceAmount.Amount'] end
      end
    else return {},'unrecognized runtime class '..tostring(name) end
    return vals,name
  end
  -- Stable CE symbols for persistent named resource records in the table.
  local function clearResourceSymbols()
    for i=0,5 do
      if P.symbols[i] then pcall(unregisterSymbol,'Pegasus3_Resource_'..i);P.symbols[i]=nil end
    end
  end
  P.clearResourceSymbols=clearResourceSymbols
  function P.refreshResources()
    local addresses,ctype=P.resourceAddresses()
    if not next(addresses) then
      P.lastResourceError=ctype
      clearResourceSymbols()  -- Never display stale pointers when campaign is unloaded.
      return
    end
    for i=0,5 do
      local addr=addresses[i]
      local key='Pegasus3_Resource_'..i
      if addr and P.symbols[i]~=addr then
        pcall(unregisterSymbol,key)
        registerSymbol(key,addr,true) -- resolved at runtime, not saved to .CT
        P.symbols[i]=addr
      elseif not addr and P.symbols[i] then
        pcall(unregisterSymbol,key)
        P.symbols[i]=nil
      end
    end
    P.lastResourceError=nil
  end
  -- IMPORTANT: 999/99 could be out of bounds and can make movement fail.
  -- Fleet has two ordinary movement points per turn; operatives move at fleet speed
  -- and normally perform one operation per turn (game guide / analysis).
  P.cap={fleet=2,operativeMove=2,operativeAction=1}
  function P.recoverAbnormalPoints()
    local fleetFixed,opMoveFixed,opActionFixed=0,0,0
    for _,f in ipairs(P.fleets()) do
      local addr=f+a['StarFleet.&lt;MovementPoints&gt;k__BackingField']
      local v=readInteger(addr)
      if v and v&gt;P.cap.fleet and v&lt;1000000 then
        if writeInteger(addr,P.cap.fleet) then fleetFixed=fleetFixed+1 end
      end
    end
    for _,o in ipairs(P.operatives()) do
      local m=o+a['StarOperative.&lt;MovementPoints&gt;k__BackingField']
      local ac=o+a['StarOperative.&lt;ActionPoints&gt;k__BackingField']
      local vm=readInteger(m);local va=readInteger(ac)
      if vm and vm&gt;P.cap.operativeMove and vm&lt;1000000 then
        if writeInteger(m,P.cap.operativeMove) then opMoveFixed=opMoveFixed+1 end
      end
      if va and va&gt;P.cap.operativeAction and va&lt;1000000 then
        if writeInteger(ac,P.cap.operativeAction) then opActionFixed=opActionFixed+1 end
      end
    end
    return fleetFixed,opMoveFixed,opActionFixed
  end
  -- Continuous refills, bounded at legitimate natural values; no 999/99 writes.
  -- Only on the active player's fleet / operative objects, never enemy objects.
  function P.applyMovement()
    if P.flags.fleet then
      for _,f in ipairs(P.fleets()) do
        local addr=f+a['StarFleet.&lt;MovementPoints&gt;k__BackingField']
        local n=readInteger(addr)
        if n and n&gt;=0 and n&lt;1000000 and n~=P.cap.fleet then
          writeInteger(addr,P.cap.fleet)
        end
      end
    end
    if P.flags.operative then
      for _,o in ipairs(P.operatives()) do
        local mp=o+a['StarOperative.&lt;MovementPoints&gt;k__BackingField']
        local ap=o+a['StarOperative.&lt;ActionPoints&gt;k__BackingField']
        local m=readInteger(mp);local n=readInteger(ap)
        if m and m&gt;=0 and m&lt;1000000 and m~=P.cap.operativeMove then writeInteger(mp,P.cap.operativeMove) end
        if n and n&gt;=0 and n&lt;1000000 and n~=P.cap.operativeAction then writeInteger(ap,P.cap.operativeAction) end
      end
    end
  end
  -- V4: Actual managed Unit.isImmortal field (Boolean), only human combat units.
  -- We do not call Mono methods, JIT patch or change enemy units.
  P.immortalBefore={}
  function P.humanCombatUnits()
    local human=P.combatPlayer()
    if not human then return {},nil end
    local list=P.ptr(human+a['Player.&lt;Units&gt;k__BackingField'])
    local result={}
    for _,unit in ipairs(P.list(list,4096)) do
      if P.ptr(unit+a['Unit.Owner'])==human then result[#result+1]=unit end
    end
    return result,human
  end
  function P.applyImmortality()
    local units,human=P.humanCombatUnits()
    if not human then P.immortalBefore={} return 0,0 end
    local newly,changed=0,0
    for _,unit in ipairs(units) do
      local addr=unit+a['Unit.isImmortal']
      local old=readByte(addr)
      if old==0 or old==1 then
        if P.immortalBefore[unit]==nil then
          P.immortalBefore[unit]=old;newly=newly+1
        end
        if old==0 and writeBytes(addr,1) then changed=changed+1 end
      end
    end
    return newly,changed
  end
  function P.restoreImmortality()
    local units,human=P.humanCombatUnits()
    local changed=0
    if human then
      for _,unit in ipairs(units) do
        local original=P.immortalBefore[unit]
        if original==0 or original==1 then
          local addr=unit+a['Unit.isImmortal']
          local current=readByte(addr)
          if (current==0 or current==1) and current~=original and writeBytes(addr,original) then
            changed=changed+1
          end
        end
      end
    end
    P.immortalBefore={}
    return changed
  end
  -- V4: Avoid arbitrary Mono method invocation on Cheat Engine thread.
  -- The game itself runs StarFleet.TickRepair on its normal update pathway.
  -- That function decrements remaining turns and repairs at zero.
  -- Setting active repairs to 1 lets the normal game tick finish the repair.
  function P.safeRepairNextTick()
    local prepared,already,skipped=0,0,0
    for _,fleet in ipairs(P.fleets()) do
      local turnsAddr=fleet+a['StarFleet.&lt;RepairTurnsLeft&gt;k__BackingField']
      local activeAddr=fleet+a['StarFleet.&lt;IsRepairing&gt;k__BackingField']
      local remaining=readInteger(turnsAddr)
      local active=readByte(activeAddr)
      if active==1 and remaining and remaining&gt;1 and remaining&lt;10000 then
        if writeInteger(turnsAddr,1) then prepared=prepared+1 end
      elseif active==1 and remaining==1 then already=already+1
      else skipped=skipped+1 end
    end
    return prepared,already,skipped
  end
  -- V4: StarUnit.ConstructionTick returns immediately if remaining&lt;=0.
  -- Thus '0' from old scripts can stall finishing permanently. Restore to
  -- a one-tick state and allow in-game construction logic to finalize it.
  function P.safeBuildNextTick()
    local human=P.player(); if not human then error('No human player loaded') end
    local prepared,correctedZero,already=0,0,0
    local seen={}
    local ownedStars=P.ptr(human+a['GrandPlayer.&lt;Stars&gt;k__BackingField'])
    for _,star in ipairs(P.list(ownedStars,4096)) do
      if P.ptr(star+a['Star.&lt;Owner&gt;k__BackingField'])==human then
        local cons=P.ptr(star+a['Star.&lt;UnitConstruction&gt;k__BackingField'])
        local queue=cons and P.ptr(cons+a['UnitConstruction.queue'])
        for _,unit in ipairs(P.list(queue,2048)) do
          if not seen[unit] then
            seen[unit]=true
            local left=unit+a['StarUnit.&lt;RemainingConstruction&gt;k__BackingField']
            local total=unit+a['StarUnit.&lt;CumulativeRemainingConstruction&gt;k__BackingField']
            local n=readInteger(left)
            local c=readInteger(total)
            if n and n&gt;=0 and n&lt;100000 and c and c&gt;=0 and c&lt;100000 then
              if n==0 then correctedZero=correctedZero+1 end
              if n~=1 then
                if writeInteger(left,1) then prepared=prepared+1 end
              else already=already+1 end
              if c~=1 then writeInteger(total,1) end
            end
          end
        end
      end
    end
    return prepared,correctedZero,already
  end
  function P.diag()
    local path=(os.getenv('TEMP') or '.')..'\\Pegasus_V3_Diagnostics.txt'
    local f=assert(io.open(path,'w'))
    local function ln(s) f:write(s,'\n') end
    ln('Pegasus V3: runtime values (no modification during export)')
    ln('Human Player = '..tostring(P.player()))
    ln('Resource container = '..tostring(select(2,P.resourceAddresses())))
    local ar=P.resourceAddresses()
    for i=0,5 do
      local value=ar[i] and readFloat(ar[i]) or nil
      ln(string.format('RESOURCE enum=%d addr=%s value=%s',i,tostring(ar[i]),tostring(value)))
    end
    local fleets=P.fleets();local ops=P.operatives()
    ln('Player fleets='..#fleets..' operatives='..#ops)
    for i,v in ipairs(fleets) do
      ln('FLEET '..i..' move='..tostring(readInteger(v+a['StarFleet.&lt;MovementPoints&gt;k__BackingField'])))
    end
    for i,v in ipairs(ops) do
      ln('OPERATIVE '..i..' move='..tostring(readInteger(v+a['StarOperative.&lt;MovementPoints&gt;k__BackingField']))..' action='..tostring(readInteger(v+a['StarOperative.&lt;ActionPoints&gt;k__BackingField'])))
    end
    f:close();return path
  end
  function P.exportMovementIL()
    local path=(os.getenv('TEMP') or '.')..'\\Pegasus_V3_Movement_IL.txt'
    local f=assert(io.open(path,'w'))
    local methods={
      Movable={'CanMove','CanMoveSilent','CanMoveToStar','get_HasMoved','get_MovementPoints',
        'SetMovementPoints','set_MovementPoints','ConsumeMovementPoints','TryMove','Move','MoveToStar',
        'TestCreateMovementError','StartTurn'},
      StarFleet={'CanMove','CanMoveSilent','UnrestrictedMove','Move','StartTurn','get_IsGarrisonFleet'},
      StarOperative={'get_CanOperate','get_HasActionPoints','ResetActionPoints',
        'SetActionPoints','ConsumeActionPoints','SpendActionPoint','StartTurn','get_IsUnusable'}
    }
    local total=0
    for _,klass in ipairs({'Movable','StarFleet','StarOperative'}) do
      for _,methodName in ipairs(methods[klass]) do
        f:write('\n=== ',klass,'.',methodName,' ===\n')
        local id=mono_findMethod('',klass,methodName)
        if id and id~=0 then
          local ok,code=pcall(mono_method_disassemble,id)
          if ok and type(code)=='string' then
            f:write(code,'\n');total=total+1
          else f:write('Disassembly failed: ',tostring(code),'\n') end
        else f:write('Method not found\n') end
      end
    end
    f:close();return path,total
  end
  P.refreshResources()
  local t=createTimer(nil,false)
  P.timer=t
  t.Interval=200
  t.OnTimer=function()
    if not PegasusV3 or PegasusV3~=P or getOpenedProcessID()==0 then t.Enabled=false;return end
    local success,msg=pcall(function()
      P.tickCount=P.tickCount+1
      if P.tickCount%5==0 then P.refreshResources() end
      P.applyMovement()
      if P.flags.combat then P.applyImmortality() end
    end)
    if not success then
      t.Enabled=false
      showMessage('Pegasus V4 timer stopped safely due to error:\n'..tostring(msg))
    end
  end
  t.Enabled=true
  showMessage('Pegasus V4 active. Named resource symbols: '..tostring((function() local n=0;for _ in pairs(P.symbols) do n=n+1 end;return n end)())..'/6'..'\nFirst run 04 to fix the old 999/99 points, then test 02 / 03 separately.'..'\nMovement / action are capped at 2 / 2 / 1, NOT 999 / 99.')
end)
if not ok then PegasusV3=nil;showMessage('Pegasus V4 activation failed:\n'..tostring(err)) end
[DISABLE]
if PegasusV3 then
  local P=PegasusV3
  if P.timer then P.timer.destroy() end
  if P.restoreImmortality then P.restoreImmortality() end
  if P.clearResourceSymbols then P.clearResourceSymbols() end
  PegasusV3=nil
end
</AssemblerScript></CheatEntry><CheatEntry><ID>3002</ID><Description>"Resources | persistent named Mono-resolved pointers | Float | enable 01"</Description><GroupHeader>1</GroupHeader><CheatEntries><CheatEntry><ID>3003</ID><Description>"矿物 | Minerals (enum 0, Float, runtime pointer)"</Description><VariableType>Float</VariableType><Address>Pegasus3_Resource_0</Address></CheatEntry><CheatEntry><ID>3004</ID><Description>"稀土 | Rare Earth (enum 1, Float, runtime pointer)"</Description><VariableType>Float</VariableType><Address>Pegasus3_Resource_1</Address></CheatEntry><CheatEntry><ID>3005</ID><Description>"人口 | Population (enum 2, Float, runtime pointer)"</Description><VariableType>Float</VariableType><Address>Pegasus3_Resource_2</Address></CheatEntry><CheatEntry><ID>3006</ID><Description>"科技 | Science (enum 3, Float, runtime pointer)"</Description><VariableType>Float</VariableType><Address>Pegasus3_Resource_3</Address></CheatEntry><CheatEntry><ID>3007</ID><Description>"未知资源 | Unknown (enum 4, Float, runtime pointer)"</Description><VariableType>Float</VariableType><Address>Pegasus3_Resource_4</Address></CheatEntry><CheatEntry><ID>3008</ID><Description>"幸福度 | Happiness (%) (enum 5, Float, runtime pointer)"</Description><VariableType>Float</VariableType><Address>Pegasus3_Resource_5</Address></CheatEntry></CheatEntries></CheatEntry><CheatEntry><ID>3009</ID><Description>"02 - FLEET: natural-cap movement refill to 2 (confirmed)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
if PegasusV3 then PegasusV3.flags.fleet=true else showMessage('Enable 01 - V3 Master first') end
[DISABLE]
if PegasusV3 then PegasusV3.flags.fleet=false end
</AssemblerScript></CheatEntry><CheatEntry><ID>3010</ID><Description>"03 - OPERATIVE: natural-cap move=2 action=1 (confirmed)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
if PegasusV3 then PegasusV3.flags.operative=true else showMessage('Enable 01 - V3 Master first') end
[DISABLE]
if PegasusV3 then PegasusV3.flags.operative=false end
</AssemblerScript></CheatEntry><CheatEntry><ID>3011</ID><Description>"04 - EMERGENCY: restore old V2 movement 999/99 to 2/2/1 (once)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
local P=PegasusV3
if not P then showMessage('Enable 01 - V3 Master first.');return end
local ok,v1,v2,v3=pcall(function() return P.recoverAbnormalPoints() end)
if ok then showMessage('Restored invalid points: fleets='..tostring(v1)..', operative movement='..tostring(v2)..', operative actions='..tostring(v3)..'. Test an ordinary movable fleet. Garrison fleets cannot move.') else showMessage('Pegasus V3 error:\n'..tostring(v1)) end
[DISABLE]
</AssemblerScript></CheatEntry><CheatEntry><ID>3012</ID><Description>"05 - HUMAN combat unit isImmortal flag (new, reversible; experimental)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
if not PegasusV3 then
  showMessage('Enable 01 - MASTER first.')
  return
end
PegasusV3.flags.combat=true
local ok,newN,changed=pcall(function() return PegasusV3.applyImmortality() end)
if not ok then
  PegasusV3.flags.combat=false
  showMessage('V4 invulnerability activation failed: '..tostring(newN))
end
[DISABLE]
if PegasusV3 then
  PegasusV3.flags.combat=false
  pcall(function() PegasusV3.restoreImmortality() end)
end
</AssemblerScript></CheatEntry><CheatEntry><ID>3013</ID><Description>"06 - Prepare owned ship queues for NEXT normal construction tick (no Mono invoke)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
local P=PegasusV3
if not P then showMessage('Enable 01 - MASTER first');return end
local ok,x,y,z=pcall(function() return P.safeBuildNextTick() end)
if ok then showMessage('V4 build: set to 1 tick: '..tostring(x)..'; recovered zero entries: '..tostring(y)..'; already at 1: '..tostring(z)..'. Wait for a normal construction update.')
else showMessage('V4 operation failed: '..tostring(x)) end
[DISABLE]
</AssemblerScript></CheatEntry><CheatEntry><ID>3014</ID><Description>"07 - Prepare ACTIVE owned repairs to FINISH on NEXT normal repair tick (no Mono invoke)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
local P=PegasusV3
if not P then showMessage('Enable 01 - MASTER first');return end
local ok,x,y,z=pcall(function() return P.safeRepairNextTick() end)
if ok then showMessage('V4 repair: shortened active repairs: '..tostring(x)..'; already at 1 turn: '..tostring(y)..'; other fleets skipped: '..tostring(z)..'. Advance normally for game repair logic.')
else showMessage('V4 operation failed: '..tostring(x)) end
[DISABLE]
</AssemblerScript></CheatEntry><CheatEntry><ID>3015</ID><Description>"08 - Export V3 runtime diagnosis (read only)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
