</AssemblerScript></CheatEntry><CheatEntry><ID>3017</ID><Description>"IMPORTANT: disable V3.1 master &amp; all toggles BEFORE enabling V4"</Description><GroupHeader>1</GroupHeader><CheatEntries /></CheatEntry><CheatEntry><ID>3018</ID><Description>"IMPORTANT: V4 repairs/ship construction finalize on normal game update; not instant in same frame"</Description><GroupHeader>1</GroupHeader><CheatEntries /></CheatEntry><CheatEntry><ID>3019</ID><Description>"IMPORTANT: 05 is only combat and must be enabled during combat; save backup before experiment"</Description><GroupHeader>1</GroupHeader><CheatEntries /></CheatEntry><CheatEntry><ID>9100</ID><Description>"10 - READ ONLY: export combat, repair and construction IL + runtime snapshot"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
local P=PegasusV3
if not P then
  showMessage('请先在 V3 表格启用 01 MASTER。\nEnable V3 01 MASTER before using this read-only report.')
  return
end
local ok,result=pcall(function()
  local path=(os.getenv('TEMP') or '.')..'\\Pegasus_V3_OtherFunctions_Report.txt'
  local f=assert(io.open(path,'w'))
  local function emit(s) f:write(tostring(s or ''),'\n') end
  local function hex(x) if type(x)=='number' and x&gt;0 then return string.format('0x%X',x) end return 'nil' end
  local function safe(fn,...) local ok,v=pcall(fn,...); if ok then return v end end
  local function fieldOffset(className,fieldName)
    local id=P.ids[className] or safe(mono_findClass,'',className)
    if not id or id==0 then return nil end
    for _,x in ipairs(safe(mono_class_enumFields,id,true) or {}) do
      if x.name==fieldName and not x.isStatic then return x.offset end
    end
  end
  local function pfield(className,fieldName,ptr)
    local o=fieldOffset(className,fieldName)
    return o and P.ptr(ptr+o) or nil
  end
  local function ifield(className,fieldName,ptr)
    local o=fieldOffset(className,fieldName)
    return o and safe(readInteger,ptr+o) or nil
  end
  local function bfield(className,fieldName,ptr)
    local o=fieldOffset(className,fieldName)
    return o and safe(readBytes,ptr+o,1,false) or nil
  end
  local function listobj(x,maxn)
    if not x then return {} end
    return safe(P.list,x,maxn) or {}
  end
  emit('THE PEGASUS EXPEDITION | V3 supplemental read-only diagnostics')
  emit('No game fields or managed methods are changed by this script.')
  emit('Human GrandPlayer: '..hex(P.player()))
  emit('Combat Player (Main.HumanPlayer): '..hex(P.combatPlayer()))
  emit('')
  emit('=== OWNED FLEET REPAIR STATUS (up to first 30) ===')
  local fleets=P.fleets();emit('Owned fleets: '..#fleets)
  for i=1,math.min(#fleets,30) do
    local v=fleets[i]
    emit(string.format('Fleet %d ptr=%s repairTurnsLeft=%s isRepairing=%s',i,hex(v),
      tostring(ifield('StarFleet','&lt;RepairTurnsLeft&gt;k__BackingField',v)),
      tostring(bfield('StarFleet','&lt;IsRepairing&gt;k__BackingField',v))))
  end
  emit('')
  emit('=== OWNED SHIP CONSTRUCTION QUEUES (up to 70 stars, up to 15 units per star) ===')
  local hum=P.player()
  if hum then
    local stars=listobj(pfield('GrandPlayer','&lt;Stars&gt;k__BackingField',hum),4096)
    emit('Stars in human list: '..#stars)
    local queuedStars=0;local queuedUnits=0
    for i=1,math.min(#stars,70) do
      local star=stars[i]
      if pfield('Star','&lt;Owner&gt;k__BackingField',star)==hum then
        local cons=pfield('Star','&lt;UnitConstruction&gt;k__BackingField',star)
        local q=listobj(cons and pfield('UnitConstruction','queue',cons),2048)
        if #q&gt;0 then
          queuedStars=queuedStars+1
          emit(string.format('Star #%d: %s queue=%d',i,hex(star),#q))
          for j=1,math.min(#q,15) do
            local unit=q[j]
            queuedUnits=queuedUnits+1
            emit(string.format('  shipQueue %d unit=%s remaining=%s cumulative=%s',j,hex(unit),
              tostring(ifield('StarUnit','&lt;RemainingConstruction&gt;k__BackingField',unit)),
              tostring(ifield('StarUnit','&lt;CumulativeRemainingConstruction&gt;k__BackingField',unit))))
          end
        end
      end
    end
    emit('Queued owned stars: '..queuedStars..'; ship entries sampled: '..queuedUnits)
  end
  emit('')
  emit('=== BATTLE UNITS / SHIPS (first 8 units, up to 8 ships each) ===')
  local combatPlayer=P.combatPlayer()
  if combatPlayer then
    local units=listobj(pfield('Player','&lt;Units&gt;k__BackingField',combatPlayer),2048)
    emit('Combat human unit count = '..#units)
    for i=1,math.min(#units,8) do
      local unit=units[i]
      local owner=pfield('Unit','Owner',unit)
      local ships=listobj(pfield('Unit','&lt;Ships&gt;k__BackingField',unit),4096)
      emit(string.format('Battle unit %d ptr=%s owner=%s isHuman=%s ships=%d',i,hex(unit),hex(owner),tostring(owner==combatPlayer),#ships))
      for j=1,math.min(#ships,8) do
        local ship=ships[j]
        emit(string.format('  ship %d obj=%s hpRaw=%s maxRaw=%s',j,hex(ship),
          tostring(ifield('ShipC','health',ship)),tostring(ifield('ShipC','maximumHealth',ship))))
      end
    end
  else
    emit('No Main.HumanPlayer object; enter a real-time battle for a meaningful combat snapshot.')
  end
  emit('')
  emit('=== MONO METHOD SIGNATURES + IL (READ ONLY) ===')
  local targets={
    ShipC={'TakeDamage','TakeWaveDamage','get_Alive','get_HealthFraction'},
    Unit={'TakeDamage','DamageAllShips','CalculateDamageAmount','DealDamageToTarget','get_Health','get_HealthFraction'},
    Player={'CalculateCombatHealth','CalculateTotalCombatHealth','HealthAdder'},
    StarFleet={'RepairByAmount','RepairCost','RepairTime','SelfRepair','TickRepair','CancelRepair',
       'SetRepairTurns','SetRepairing','TakeAutoResolveDamage','TakeHazardSystemDamage',
       'SetMinimumHealth','get_HasRepairTurnsLeft','get_HasPaidRepairCost'},
    StarUnit={'RepairUnit','ConstructionTick','StartConstruction','SetHealthFraction',
       'get_ConstructionProgressFraction','get_UnderConstruction'},
    UnitConstruction={'RefreshAll','RefreshDisplay','Remove'},
    PlayerConstruction={'UnitConstructionTick','UnitConstructionTickStar',
       'CalculateCumulativeUnitConstructionPowerStar','TurnStart'},
  }
  local classes={'ShipC','Unit','Player','StarFleet','StarUnit','UnitConstruction','PlayerConstruction'}
  local total=0
  for _,name in ipairs(classes) do
    local id=P.ids[name] or safe(mono_findClass,'',name)
    local methods=id and safe(mono_class_enumMethods,id) or {}
    local wanted={}
    for _,n in ipairs(targets[name]) do wanted[n]=true end
    emit('')
    emit('--- class '..name..' ---')
    if not id or id==0 then emit('Class not present')
    else
      local matches=0
      for _,m in ipairs(methods) do
        if wanted[m.name] then
          matches=matches+1;total=total+1
          emit(string.format('\n[method %s.%s, id=%s]',name,m.name,hex(m.method)))
          local okSig,sig,pnames,rtype=pcall(mono_method_getSignature,m.method)
          emit('Signature: '..(okSig and tostring(sig) or '(signature unavailable)'))
          if okSig then emit('Returns: '..tostring(rtype)) end
          local okIL,il=pcall(mono_method_disassemble,m.method)
          if okIL and type(il)=='string' then emit(il:sub(1,20000))
          else emit('IL unavailable: '..tostring(il)) end
        end
      end
      emit('Methods dumped for '..name..': '..matches)
    end
  end
  emit('\nTOTAL METHOD ENTRIES: '..total)
  f:close()
  return path,total,#fleets
end)
if ok then
  showMessage('Read-only report exported.\n'..tostring(result)..'\n\nOpen %TEMP% and upload the report.\nTo repeat: uncheck this entry and check again.')
else
  showMessage('Report failed (no memory changes): '..tostring(result))
end
[DISABLE]
</AssemblerScript></CheatEntry><CheatEntry><ID>9800</ID><Description>"WARNING | V3.1 repair script 07 used mono_invoke_method and can hang/crash: V4 removed that call"</Description><GroupHeader>1</GroupHeader></CheatEntry><CheatEntry><ID>9811</ID><Description>"11 - READ ONLY: count human combat Unit.isImmortal flags (before/after 05)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
local P=PegasusV3
if not P then showMessage('Enable 01 - MASTER first');return end
local units,human=P.humanCombatUnits()
if not human then showMessage('No live combat player. Execute while in a battle.');return end
local on,off,invalid=0,0,0
for _,unit in ipairs(units) do
  local flag=readByte(unit+P.a['Unit.isImmortal'])
  if flag==1 then on=on+1 elseif flag==0 then off=off+1 else invalid=invalid+1 end
end
showMessage('Owned combat units: '..#units..'\nImmortal=true: '..on..'\nImmortal=false: '..off..'\nUnreadable/invalid: '..invalid)
[DISABLE]
</AssemblerScript></CheatEntry></CheatEntries></CheatEntry></CheatEntries></CheatTable>